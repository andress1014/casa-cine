# Guarida usa archivos locales. No necesita servicios externos.
PORT=3210
HOST=0.0.0.0
# Ruta absoluta opcional: DATA_DIR=D:\CasaCineData
# Sin valor, usa ./data junto al proyecto.
DATA_DIR=
MAX_UPLOAD_GB=30
# Documentos, fotos y comprimidos: límite por archivo.
MAX_FILE_UPLOAD_GB=2
# Opcional: exige este código para entrar desde cualquier dispositivo.
# Recomendado si Wi-Fi se comparte con invitados.
HOUSE_CODE=
# TV descubre servidor por UDP 3211. Usa off para conexión únicamente manual.
DISCOVERY=on
# Rutas opcionales para reemplazar FFmpeg incluido en npm.
FFMPEG_PATH=
FFPROBE_PATH=

# Acceso desde internet mediante túnel en esta PC (opcional). Dominios separados por coma;
# punto inicial acepta subdominios, por ejemplo .trycloudflare.com. Usa siempre HOUSE_CODE con esto.
PUBLIC_HOSTS=

# Gaming PS1 (hasta 1 GB). SNES tiene límite de 16 MB.
MAX_GAME_UPLOAD_GB=1
# HTTPS adicional para controles en otros dispositivos. HTTP 3210 sigue disponible.
TLS_PORT=3443
TLS_CERT=
TLS_KEY=

# Carátulas y sinopsis opcionales. Una credencial basta. Nunca se envía al navegador.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
