# Guarida usa archivos locales. No necesita servicios externos.
PORT=3210
HOST=0.0.0.0
# Ruta absoluta opcional: DATA_DIR=D:\CasaCineData
# Sin valor, usa ./data junto al proyecto.
DATA_DIR=
MAX_UPLOAD_GB=30
# Documentos, fotos y comprimidos: límite por archivo.
MAX_FILE_UPLOAD_GB=2
# Opcional: exige este código para entrar desde cualquier dispositivo.
# Recomendado si Wi-Fi se comparte con invitados.
HOUSE_CODE=
# TV descubre servidor por UDP 3211. Usa off para conexión únicamente manual.
DISCOVERY=on
# Rutas opcionales para reemplazar FFmpeg incluido en npm.
FFMPEG_PATH=
FFPROBE_PATH=
