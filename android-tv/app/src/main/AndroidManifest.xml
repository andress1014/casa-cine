<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <queries>
        <intent><action android:name="android.content.pm.action.CONFIRM_INSTALL" /></intent>
        <intent><action android:name="android.content.pm.action.CONFIRM_PERMISSIONS" /></intent>
    </queries>
    <application android:label="@string/app_name" android:theme="@style/AppTheme"
        android:icon="@drawable/app_icon" android:banner="@drawable/tv_banner"
        android:allowBackup="false" android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <receiver android:name=".InstallResultReceiver" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PlayerActivity" android:exported="false" android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation|screenSize" />
        <activity android:name=".GamingActivity" android:exported="false" android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation|screenSize" />
        <activity android:name=".GamePlayerActivity" android:exported="false" android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation|screenSize" />
    </application>
</manifest>
